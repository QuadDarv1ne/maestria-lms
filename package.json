{
  "name": "maestria-lms",
  "version": "3.6.0",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "node scripts/setup.js",
    "dev:sqlite": "node scripts/setup.js --db sqlite",
    "dev:pg": "node scripts/setup.js --db postgresql",
    "dev:mongo": "node scripts/setup.js --db mongodb",
    "build": "next build && node scripts/copy-build-assets.js",
    "start": "NODE_ENV=production node .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "db:push": "node scripts/prisma-auto.js db push",
    "db:generate": "node scripts/prisma-auto.js generate",
    "db:migrate": "node scripts/prisma-auto.js migrate dev",
    "db:reset": "node scripts/prisma-auto.js migrate reset",
    "db:studio": "node scripts/prisma-auto.js studio",
    "db:setup:sqlite": "node scripts/db-setup.js setup --provider sqlite --force --seed",
    "db:setup:pg": "node scripts/db-setup.js setup --provider postgresql --force --seed",
    "db:setup:mysql": "node scripts/db-setup.js setup --provider mysql --force --seed",
    "db:setup:mongodb": "node scripts/db-setup.js setup --provider mongodb --force --seed",
    "db:switch": "node scripts/db-setup.js switch",
    "db:info": "node scripts/db-setup.js info",
    "db:auto": "node scripts/db-setup.js auto",
    "docker:db": "docker compose -f docker-compose.db.yml up -d",
    "docker:db:stop": "docker compose -f docker-compose.db.yml down",
    "docker:db:logs": "docker compose -f docker-compose.db.yml logs -f",
    "prepare": "node -e \"if (process.env.HUSKY !== '0' && require('fs').existsSync(require('path').join(process.cwd(), 'node_modules', 'husky', 'bin', 'husky'))) require('child_process').execSync('husky', { stdio: 'inherit' })\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.82.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.23.2",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.10.1",
    "jiti": "^2.4.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-auth": "^4.24.11",
    "otplib": "^12.0.1",
    "prisma": "^7.9.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.81.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.12.3",
    "sanitize-html": "^2.17.4",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
  },
  "optionalDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@tailwindcss/oxide-linux-x64-gnu": "4.1.18",
    "@tailwindcss/oxide-linux-x64-musl": "4.1.18",
    "better-sqlite3": "^12.11.1",
    "lightningcss-linux-x64-gnu": "1.30.2",
    "lightningcss-linux-x64-musl": "1.30.2"
  },
  "devDependencies": {
    "@prisma/adapter-libsql": "^7.10.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "5.0.0",
    "@vitest/coverage-v8": "3.1.1",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "3.1.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --no-error-on-unmatched-pattern",
      "tsc --noEmit --skipLibCheck"
    ]
  }
}
