@@ -367,6 +367,9 @@ model Payment {
   createdAt       DateTime @default(now())
   updatedAt       DateTime @updatedAt
 
+  // Linked webhook events (audit trail + idempotency).
+  webhookEvents   PaymentWebhookEvent[]
+
   @@index([userId])
   @@index([courseId])
   @@index([status])
@@ -375,9 +378,30 @@ model Payment {
   // Additional composite indexes for analytics
   @@index([status, createdAt])
   @@index([paymentMethod, status])
+  @@index([paymentProvider, status])
   @@index([createdAt])
 }
 
+// ============ PAYMENT WEBHOOK EVENTS (idempotency + audit) ============
+// Stores every webhook we receive from any provider. The unique eventId
+// guarantees at-most-once processing: duplicate delivery from the provider
+// is rejected by the DB unique constraint.
+
+model PaymentWebhookEvent {
+  id            String   @id @default(uuid())
+  paymentId     String?  // null until payment is identified
+  payment       Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
+  provider      String   // YOOKASSA | TINKOFF | CLOUDPAYMENTS | ...
+  eventId       String   @unique // globally unique event id from provider
+  event         String   // e.g. "payment.succeeded", "refund.succeeded"
+  payload       String   // raw JSON payload
+  processedAt   DateTime @default(now())
+
+  @@index([paymentId])
+  @@index([provider, event])
+  @@index([processedAt])
+}
+
 // ============ NOTIFICATIONS ============
 
 model Notification {
