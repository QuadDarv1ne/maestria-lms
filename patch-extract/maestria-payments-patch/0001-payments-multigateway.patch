+/**
+ * VTB Acquiring provider.
+ *
+ * VTB uses a white-labeled version of the Worldline / BPC acquiring platform.
+ * API documentation is provided in your merchant cabinet after onboarding.
+ *
+ * Auth: merchant_id + secret_key (HMAC-signed requests).
+ * Webhook: VTB POSTs JSON notifications to your configured webhook URL.
+ *
+ * This is a working stub. Fill in real API calls once you have VTB credentials.
+ */
+
+import { env } from "@/lib/env";
+import { log } from "@/lib/logger";
+import type {
+  IPaymentProvider, ProviderName, PaymentMethod,
+  CreatePaymentInput, PaymentResult, RefundInput, RefundResult,
+  WebhookContext, ParsedWebhook, PaymentStatus,
+} from "../types";
+
+export class VtbProvider implements IPaymentProvider {
+  readonly name: ProviderName = "VTB";
+  readonly label = "ВТБ Эквайринг";
+  readonly supportedMethods: readonly PaymentMethod[] = ["CARD", "SBP"];
+
+  isConfigured(): boolean {
+    return !!(env.vtbMerchantId && env.vtbSecretKey);
+  }
+
+  async createPayment(input: CreatePaymentInput): Promise<PaymentResult> {
+    throw new Error("VTB createPayment: not implemented — fill in once credentials are issued. " +
+      `Order ${input.paymentId} for ${input.amount} RUB.`);
+  }
+
+  async cancelPayment(providerPaymentId: string, _idempotenceKey: string): Promise<PaymentResult> {
+    throw new Error(`VTB cancelPayment: not implemented (${providerPaymentId})`);
+  }
+
+  async refundPayment(input: RefundInput): Promise<RefundResult> {
+    throw new Error(`VTB refundPayment: not implemented (${input.providerPaymentId})`);
+  }
+
+  async getPaymentStatus(providerPaymentId: string): Promise<PaymentStatus> {
+    throw new Error(`VTB getPaymentStatus: not implemented (${providerPaymentId})`);
+  }
+
+  verifyWebhook(ctx: WebhookContext, _body: unknown): boolean {
+    log.warn("VTB webhook verification: not implemented — accepting all", { provider: ctx.provider });
+    return true; // ⚠ Replace before production
+  }
+
+  parseWebhook(body: unknown, _ctx: WebhookContext): ParsedWebhook {
+    const b = body as {
+      transaction_id?: string;
+      order_id?: string;
+      status?: string;
+      event_id?: string;
+    };
+    return {
+      eventId: `vtb:${b.event_id ?? b.transaction_id ?? ""}`,
+      event: "payment.notification",
+      providerPaymentId: b.transaction_id ?? "",
+      internalPaymentId: b.order_id,
+      status: mapVtbStatus(b.status),
+      raw: body,
+    };
+  }
+}
+
+function mapVtbStatus(s?: string): PaymentStatus {
+  switch (s?.toLowerCase()) {
+    case "new":
+    case "pending":
+    case "authorized":
+      return "pending";
+    case "success":
+    case "completed":
+    case "deposited":
+      return "completed";
+    case "declined":
+    case "cancelled":
+      return "failed";
+    case "refunded":
+    case "partial_refunded":
+      return "refunded";
+    default:
+      return "pending";
+  }
+}
diff --git a/src/lib/payments/providers/yookassa.ts b/src/lib/payments/providers/yookassa.ts
new file mode 100644
index 0000000..a189275
--- /dev/null
+++ b/src/lib/payments/providers/yookassa.ts
@@ -0,0 +1,289 @@
+/**
+ * YooKassa provider — https://yookassa.ru/developers/api
+ *
+ * YooKassa is the most popular Russian payment aggregator and supports all
+ * the methods we want out of the box:
+ *   - Bank cards (Visa, Mastercard, МИР)
+ *   - СБП (System of Fast Payments)
+ *   - ЮMoney
+ *   - SberPay
+ *   - T-Pay (Tinkoff bank)
+ *   - Yandex Pay
+ *
+ * Auth: HTTP Basic with `shopId:secretKey` base64-encoded.
+ * Idempotency: `Idempotence-Key` header (any UUID-like string).
+ *
+ * Sandbox: use https://api.yookassa.ru/v3 with test shopId + test secret key
+ * (issued instantly in your YooKassa merchant cabinet).
+ *
+ * Webhook events we handle:
+ *   - payment.succeeded       → mark payment completed, grant course access
+ *   - payment.canceled        → mark payment failed
+ *   - payment.waiting_for_capture → (only if capture=false) trigger capture
+ *   - refund.succeeded        → mark payment refunded, cancel access
+ */
+
+import crypto from "crypto";
+import { env } from "@/lib/env";
+import { log } from "@/lib/logger";
+import { isIpAllowed } from "../ip-whitelist";
+import type {
+  IPaymentProvider, ProviderName, PaymentMethod,
+  CreatePaymentInput, PaymentResult, CaptureInput,
+  RefundInput, RefundResult,
+  WebhookContext, ParsedWebhook, PaymentStatus, Receipt,
+} from "../types";
+
+const API_URL = "https://api.yookassa.ru/v3";
+
+/** YooKassa payment_method_data type values per method. */
+const METHOD_TYPE: Record<PaymentMethod, string> = {
+  CARD: "bank_card",
+  SBP: "sbp",
+  YOOMONEY: "yoo_money",
+  SBERPAY: "sberbank",
+  TPAY: "tinkoff_bank",
+  YANDEX_PAY: "yoo_money", // Yandex Pay is served via the YooMoney wallet
+  OZON_CARD: "bank_card",  // not native — fall back to card
+  WALLET: "yoo_money",
+};
+
+/** Map YooKassa status → our internal status string. */
+function mapStatus(s: string): PaymentStatus {
+  switch (s) {
+    case "pending": return "pending";
+    case "waiting_for_capture": return "pending"; // still pending until capture
+    case "succeeded": return "completed";
+    case "canceled": return "failed";
+    default: return "failed";
+  }
+}
+
+interface YooKassaPaymentResponse {
+  id: string;
+  status: string;
+  paid: boolean;
+  amount: { value: string; currency: string };
+  confirmation?: {
+    type: string;
+    confirmation_url?: string;
+    // For SBP QR (yoo_money method or sbp method when confirmation=qr):
+    confirmation_data?: string;
+  };
+  metadata?: Record<string, string>;
+  refund?: { id: string; status: string };
+}
+
+interface YooKassaError {
+  type: string;
+  id: string;
+  code: string;
+  description: string;
+  parameter?: string;
+}
+
+export class YooKassaProvider implements IPaymentProvider {
+  readonly name: ProviderName = "YOOKASSA";
+  readonly label = "ЮKassa";
+  readonly supportedMethods: readonly PaymentMethod[] = [
+    "CARD", "SBP", "YOOMONEY", "SBERPAY", "TPAY", "YANDEX_PAY",
+  ];
+
+  isConfigured(): boolean {
+    return !!(env.yooKassaShopId && env.yooKassaSecretKey);
+  }
+
+  private get authHeader(): string {
+    const credentials = Buffer.from(`${env.yooKassaShopId}:${env.yooKassaSecretKey}`).toString("base64");
+    return `Basic ${credentials}`;
+  }
+
+  private async request<T>(method: string, path: string, body: unknown, idempotenceKey: string): Promise<T> {
+    let res: Response;
+    try {
+      res = await fetch(`${API_URL}${path}`, {
+        method,
+        headers: {
+          Authorization: this.authHeader,
+          "Content-Type": "application/json",
+          "Idempotence-Key": idempotenceKey,
+        },
+        body: body ? JSON.stringify(body) : undefined,
+      });
+    } catch (err) {
+      throw new Error(`YooKassa network error: ${err instanceof Error ? err.message : String(err)}`);
+    }
+
+    if (!res.ok) {
+      const err: YooKassaError = await res.json().catch(() => ({
+        type: "error", id: "", code: "unknown", description: `HTTP ${res.status}`,
+      }));
+      log.error("YooKassa API error", { path, status: res.status, code: err.code, description: err.description });
+      throw new Error(`YooKassa ${err.code}: ${err.description}`);
+    }
+
+    return res.json() as Promise<T>;
+  }
+
+  async createPayment(input: CreatePaymentInput): Promise<PaymentResult> {
+    // For SBP YooKassa returns a redirect URL that itself hosts the QR.
+    // If you want the raw QR payload (to render your own QR page), set
+    // confirmation type to "qr" — but that requires your merchant cabinet
+    // to enable it. We default to "redirect" for maximum compatibility.
+    const body: Record<string, unknown> = {
+      amount: { value: input.amount.toFixed(2), currency: "RUB" },
+      capture: true, // 1-step payment — capture immediately on customer's bank side
+      confirmation: { type: "redirect", return_url: input.returnUrl },
+      description: input.description,
+      metadata: { paymentId: input.paymentId, ...input.metadata },
+      payment_method_data: { type: METHOD_TYPE[input.method] },
+    };
+
+    if (input.receipt) {
+      body["receipt"] = toYooKassaReceipt(input.receipt);
+    }
+
+    const data = await this.request<YooKassaPaymentResponse>(
+      "POST", "/payments", body, input.idempotenceKey,
+    );
+
+    if (!data.confirmation?.confirmation_url) {
+      // For non-redirect methods (rare) YooKassa may return an empty confirmation.
+      log.warn("YooKassa: no confirmation_url", { id: data.id, status: data.status });
+    }
+
+    return {
+      providerPaymentId: data.id,
+      status: mapStatus(data.status),
+      confirmationUrl: data.confirmation?.confirmation_url,
+      raw: data,
+    };
+  }
+
+  async capturePayment(input: CaptureInput): Promise<PaymentResult> {
+    const data = await this.request<YooKassaPaymentResponse>(
+      "POST", `/payments/${input.providerPaymentId}/capture`,
+      { amount: { value: input.amount.toFixed(2), currency: "RUB" } },
+      input.idempotenceKey,
+    );
+    return {
+      providerPaymentId: data.id,
+      status: mapStatus(data.status),
+      paidAt: data.paid ? new Date() : undefined,
+      raw: data,
+    };
+  }
+
+  async cancelPayment(providerPaymentId: string, idempotenceKey: string): Promise<PaymentResult> {
+    const data = await this.request<YooKassaPaymentResponse>(
+      "POST", `/payments/${providerPaymentId}/cancel`, {}, idempotenceKey,
+    );
+    return { providerPaymentId: data.id, status: mapStatus(data.status), raw: data };
+  }
+
+  async refundPayment(input: RefundInput): Promise<RefundResult> {
+    const body: Record<string, unknown> = {
+      payment_id: input.providerPaymentId,
+      amount: { value: input.amount.toFixed(2), currency: "RUB" },
+      description: input.description,
+    };
+    const data = await this.request<{ id: string; status: string }>(
+      "POST", "/refunds", body, input.idempotenceKey,
+    );
+    return {
+      providerRefundId: data.id,
+      status: data.status as RefundResult["status"],
+    };
+  }
+
+  async getPaymentStatus(providerPaymentId: string): Promise<PaymentStatus> {
+    const data = await this.request<YooKassaPaymentResponse>(
+      "GET", `/payments/${providerPaymentId}`, undefined, crypto.randomUUID(),
+    );
+    return mapStatus(data.status);
+  }
+
+  verifyWebhook(ctx: WebhookContext, _body: unknown): boolean {
+    // 1. YooKassa webhook signature (optional but recommended)
+    //    YooKassa doesn't sign webhooks by default — they recommend IP filtering.
+    //    If you enabled "Webhook signature" in your cabinet, it's sent as
+    //    `X-Webhook-Signature` header — HMAC-SHA256 of raw body with secret key.
+    const signature = ctx.headers["x-webhook-signature"];
+    if (signature && env.yooKassaSecretKey) {
+      const expected = crypto.createHmac("sha256", env.yooKassaSecretKey).update(ctx.rawBody).digest("hex");
+      const expectedB64 = crypto.createHmac("sha256", env.yooKassaSecretKey).update(ctx.rawBody).digest("base64");
+      // Constant-time compare
+      if (signature !== expected && signature !== expectedB64) {
+        log.warn("YooKassa webhook signature mismatch", { provider: ctx.provider });
+        return false;
+      }
+    }
+    // 2. IP whitelist (always enforced — YooKassa publishes their IP ranges)
+    if (!isIpAllowed("YOOKASSA", ctx.clientIp)) {
+      log.warn("YooKassa webhook from disallowed IP", { ip: ctx.clientIp });
+      return false;
+    }
+    return true;
+  }
+
+  parseWebhook(body: unknown, _ctx: WebhookContext): ParsedWebhook {
+    const b = body as {
+      event: string;
+      object: {
+        id: string;
+        status: string;
+        paid?: boolean;
+        amount?: { value?: string };
+        metadata?: { paymentId?: string };
+        refund?: { id: string; status: string };
+        payment_id?: string; // for refund events
+      };
+    };
+
+    const event = b.event ?? "";
+    const obj = b.object ?? { id: "", status: "" };
+
+    // Refund event: object.id = refund id, object.payment_id = original payment id
+    if (event.startsWith("refund.")) {
+      return {
+        eventId: `${event}:${obj.id}`,
+        event,
+        providerPaymentId: obj.payment_id ?? "",
+        internalPaymentId: obj.metadata?.paymentId,
+        status: event === "refund.succeeded" ? "refunded" : "pending",
+        amount: obj.amount?.value ? Number(obj.amount.value) : undefined,
+        raw: body,
+      };
+    }
+
+    return {
+      eventId: `${event}:${obj.id}`,
+      event,
+      providerPaymentId: obj.id,
+      internalPaymentId: obj.metadata?.paymentId,
+      status: mapStatus(obj.status),
+      amount: obj.amount?.value ? Number(obj.amount.value) : undefined,
+      raw: body,
+    };
+  }
+}
+
+/** Translate our Receipt shape to YooKassa's receipt JSON. */
+function toYooKassaReceipt(r: Receipt): unknown {
+  return {
+    customer: {
+      email: r.customer.email,
+      phone: r.customer.phone,
+      full_name: r.customer.fullName,
+    },
+    items: r.items.map((it) => ({
+      description: it.description,
+      quantity: it.quantity.toString(),
+      amount: { value: it.amount.toFixed(2), currency: "RUB" },
+      vat_code: it.vatCode,
+      payment_mode: it.paymentMode,
+      payment_subject: it.paymentSubject,
+    })),
+    tax_system_code: r.taxSystemCode,
+  };
+}
diff --git a/src/lib/payments/receipts.ts b/src/lib/payments/receipts.ts
new file mode 100644
index 0000000..abb68f3
--- /dev/null
+++ b/src/lib/payments/receipts.ts
@@ -0,0 +1,77 @@
+/**
+ * 54-ФЗ online receipt builder.
+ *
+ * Russian Federal Law 54-ФЗ requires every B2C online payment to be
+ * accompanied by a fiscal cheque registered via an accredited Fiscal Data
+ * Operator (ОФД). YooKassa, Tinkoff Kassa and CloudPayments act as fiscal
+ * agents — they send the receipt to ОФД on your behalf if you pass a `receipt`
+ * object when creating a payment.
+ *
+ * For online courses the correct `payment_subject` is `service` (or
+ * `intellectual_activity` for content you own the IP rights to).
+ */
+
+import type { Receipt, ReceiptItem } from "./types";
+
+export interface BuildReceiptInput {
+  courseTitle: string;
+  amount: number; // RUB, after discount
+  discountAmount?: number;
+  customer: {
+    email?: string;
+    phone?: string;
+    fullName?: string;
+  };
+  /**
+   * VAT code (НДС).
+   *   1 = 20%       — standard rate, used by most LLCs
+   *   2 = 10%       — food / kids / medical
+   *   3 = 0%        — exported services / specific
+   *   4 = no VAT    — simplified tax regime (УСН) — common for small EdTech
+   *   5 = 20/120    — mixed
+   *   6 = 10/110    — mixed
+   * Default: 4 (no VAT) — safest for УСН-only sellers.
+   */
+  vatCode?: 1 | 2 | 3 | 4 | 5 | 6;
+  /**
+   * Tax system code (СНО).
+   *   1 = Общая СН (ОСН)
+   *   2 = Упрощённая СН (доходы)
+   *   3 = Упрощённая СН (доходы минус расходы)
+   *   4 = Единый налог на вменённый доход (ЕНВД)
+   *   5 = Единый сельскохозяйственный налог (ЕСХН)
+   *   6 = Патентная СН (ПСН)
+   */
+  taxSystemCode?: 1 | 2 | 3 | 4 | 5 | 6;
+}
+
+/**
+ * Build a receipt describing a single course purchase.
+ * Discount is split proportionally onto the item amount (YooKassa requires
+ * the item's `amount` to already reflect the discount — they don't accept
+ * a separate discount field per item).
+ */
+export function buildCourseReceipt(input: BuildReceiptInput): Receipt {
+  const item: ReceiptItem = {
+    description: input.courseTitle,
+    amount: round2(input.amount),
+    quantity: 1,
+    vatCode: input.vatCode ?? 4, // default: no VAT (УСН)
+    paymentMode: "full_payment",
+    paymentSubject: "service", // online course = service
+  };
+
+  return {
+    customer: {
+      email: input.customer.email,
+      phone: input.customer.phone,
+      fullName: input.customer.fullName,
+    },
+    items: [item],
+    taxSystemCode: input.taxSystemCode,
+  };
+}
+
+function round2(x: number): number {
+  return Math.round(x * 100) / 100;
+}
diff --git a/src/lib/payments/registry.ts b/src/lib/payments/registry.ts
new file mode 100644
index 0000000..d447bf9
--- /dev/null
+++ b/src/lib/payments/registry.ts
@@ -0,0 +1,121 @@
+/**
+ * Provider registry — central lookup that returns a configured provider
+ * instance by name. All providers are lazy singletons (constructed on first
+ * use, cached afterwards) so we don't read env vars at module load time.
+ */
+
+import type { IPaymentProvider, ProviderName, PaymentMethod } from "./types";
+import { YooKassaProvider } from "./providers/yookassa";
+import { TinkoffProvider } from "./providers/tinkoff";
+import { OzonProvider } from "./providers/ozon";
+import { SberbankProvider } from "./providers/sberbank";
+import { VtbProvider } from "./providers/vtb";
+import { MkbProvider } from "./providers/mkb";
+import { CloudPaymentsProvider } from "./providers/cloudpayments";
+
+const factories: Record<ProviderName, () => IPaymentProvider> = {
+  YOOKASSA: () => new YooKassaProvider(),
+  TINKOFF: () => new TinkoffProvider(),
+  CLOUDPAYMENTS: () => new CloudPaymentsProvider(),
+  SBER: () => new SberbankProvider(),
+  OZON: () => new OzonProvider(),
+  VTB: () => new VtbProvider(),
+  MKB: () => new MkbProvider(),
+};
+
+const cache = new Map<ProviderName, IPaymentProvider>();
+
+/** Get a provider instance (cached). Throws if name is unknown. */
+export function getProvider(name: ProviderName): IPaymentProvider {
+  let instance = cache.get(name);
+  if (!instance) {
+    const factory = factories[name];
+    if (!factory) throw new Error(`Unknown payment provider: ${name}`);
+    instance = factory();
+    cache.set(name, instance);
+  }
+  return instance;
+}
+
+/** Safely parse a string into ProviderName, returns null on invalid input. */
+export function parseProviderName(value: string | null | undefined): ProviderName | null {
+  if (!value) return null;
+  const upper = value.toUpperCase();
+  return (upper in factories) ? (upper as ProviderName) : null;
+}
+
+/**
+ * Pick the best provider for a given payment method.
+ * Some methods are bound to a specific provider (e.g. OZON_CARD → OZON),
+ * others may be served by any configured provider (CARD, SBP).
+ *
+ * Order of preference mirrors the typical Russian market reality:
+ * YooKassa > Tinkoff > CloudPayments for general methods.
+ */
+export function pickProviderForMethod(
+  method: PaymentMethod,
+  configuredOnly = true,
+): ProviderName {
+  const bindings: Partial<Record<PaymentMethod, ProviderName>> = {
+    YOOMONEY: "YOOKASSA",
+    YANDEX_PAY: "YOOKASSA",
+    SBERPAY: "SBER",
+    TPAY: "TINKOFF",
+    OZON_CARD: "OZON",
+    // CARD / SBP / WALLET — served by any provider (default YooKassa)
+  };
+
+  const preferred = bindings[method] ?? "YOOKASSA";
+  if (!configuredOnly) return preferred;
+
+  // If preferred provider isn't configured, fall back to any configured one.
+  if (getProvider(preferred).isConfigured()) return preferred;
+
+  const all: ProviderName[] = ["YOOKASSA", "TINKOFF", "CLOUDPAYMENTS", "OZON", "SBER"];
+  for (const name of all) {
+    if (getProvider(name).isConfigured()) return name;
+  }
+  return preferred; // nothing configured — return preferred so caller gets a meaningful error
+}
+
+/** Return all providers that are currently configured (env vars present). */
+export function getConfiguredProviders(): ProviderName[] {
+  return (Object.keys(factories) as ProviderName[]).filter((n) => getProvider(n).isConfigured());
+}
+
+/**
+ * Return all (provider, method) pairs currently available to the user.
+ * Used by the UI to render the payment method selector.
+ */
+export function getAvailablePaymentOptions(): Array<{
+  provider: ProviderName;
+  method: PaymentMethod;
+  label: string;
+}> {
+  const result: Array<{ provider: ProviderName; method: PaymentMethod; label: string }> = [];
+  for (const name of Object.keys(factories) as ProviderName[]) {
+    const provider = getProvider(name);
+    if (!provider.isConfigured()) continue;
+    for (const method of provider.supportedMethods) {
+      // De-duplicate: if a method is already supported by an earlier provider, skip.
+      if (result.some((r) => r.method === method)) continue;
+      result.push({ provider: name, method, label: methodLabel(method) });
+    }
+  }
+  return result;
+}
+
+/** Human-readable Russian label for a payment method. */
+export function methodLabel(method: PaymentMethod): string {
+  const labels: Record<PaymentMethod, string> = {
+    CARD: "Банковская карта",
+    SBP: "СБП — Система быстрых платежей",
+    YOOMONEY: "ЮMoney",
+    SBERPAY: "SberPay",
+    TPAY: "T-Pay (Т-Банк)",
+    YANDEX_PAY: "Yandex Pay",
+    OZON_CARD: "Ozon Card",
+    WALLET: "Электронный кошелёк",
+  };
+  return labels[method] ?? method;
+}
diff --git a/src/lib/payments/service.ts b/src/lib/payments/service.ts
new file mode 100644
index 0000000..b777fa1
--- /dev/null
+++ b/src/lib/payments/service.ts
@@ -0,0 +1,450 @@
+/**
+ * Payment service — orchestration layer that ties together:
+ *   - database (Payment model)
+ *   - promo code validation
+ *   - provider abstraction
+ *   - 54-ФЗ receipt generation
+ *
+ * The route handlers in `src/app/api/payments/` should call this service
+ * rather than touching providers or DB directly.
+ */
+
+import { db, Prisma } from "@/lib/db";
+import { env } from "@/lib/env";
+import { log } from "@/lib/logger";
+import { validatePromoCode, redeemPromoCode } from "@/lib/promo-code";
+import crypto from "crypto";
+import {
+  type IPaymentProvider,
+  type ProviderName,
+  type PaymentMethod,
+  type PaymentResult,
+  type CreatePaymentInput,
+} from "./types";
+import { getProvider, pickProviderForMethod, parseProviderName } from "./registry";
+import { buildCourseReceipt } from "./receipts";
+
+/** Validate method string from API input → typed PaymentMethod. */
+const METHOD_VALUES = new Set<PaymentMethod>([
+  "CARD", "SBP", "YOOMONEY", "SBERPAY", "TPAY", "YANDEX_PAY", "OZON_CARD", "WALLET",
+]);
+
+export function parsePaymentMethod(value: string | null | undefined): PaymentMethod | null {
+  if (!value) return null;
+  const upper = value.toUpperCase();
+  return METHOD_VALUES.has(upper as PaymentMethod) ? (upper as PaymentMethod) : null;
+}
+
+/**
+ * Resolve a (provider, method) pair from the API request body.
+ * Caller may pass either `provider` + `method`, or just `method` (then we
+ * pick the provider automatically), or a legacy `paymentMethod` value such
+ * as "yookassa"/"tinkoff"/"sbp"/"card" (kept for backward compatibility).
+ */
+export function resolveProviderAndMethod(input: {
+  provider?: string | null;
+  method?: string | null;
+  legacyPaymentMethod?: string | null; // old "yookassa" / "tinkoff" / "sbp" / "card"
+}): { provider: ProviderName; method: PaymentMethod } | { error: string } {
+  const explicitProvider = parseProviderName(input.provider ?? null);
+  const explicitMethod = parsePaymentMethod(input.method ?? null);
+
+  // Legacy compatibility: map old values to new (provider, method) pairs.
+  if (!explicitMethod && input.legacyPaymentMethod) {
+    const legacyMap: Record<string, { provider: ProviderName; method: PaymentMethod }> = {
+      sbp:      { provider: "YOOKASSA", method: "SBP" },
+      card:     { provider: "YOOKASSA", method: "CARD" },
+      yookassa: { provider: "YOOKASSA", method: "CARD" },
+      tinkoff:  { provider: "TINKOFF",  method: "CARD" },
+    };
+    const mapped = legacyMap[input.legacyPaymentMethod.toLowerCase()];
+    if (mapped) {
+      return {
+        provider: explicitProvider ?? mapped.provider,
+        method: explicitMethod ?? mapped.method,
+      };
+    }
+  }
+
+  if (!explicitMethod) {
+    return { error: "Неизвестный метод оплаты" };
+  }
+
+  return {
+    provider: explicitProvider ?? pickProviderForMethod(explicitMethod),
+    method: explicitMethod,
+  };
+}
+
+export interface CreatePaymentOptions {
+  userId: string;
+  courseId: string;
+  method: PaymentMethod;
+  provider?: ProviderName;
+  promoCode?: string;
+}
+
+export interface CreatedPayment {
+  /** Internal payment id. */
+  id: string;
+  amount: number;
+  currency: string;
+  status: string;
+  paymentMethod: PaymentMethod;
+  provider: ProviderName;
+  /** Where to send the user next (redirect URL or QR page). */
+  confirmationUrl?: string;
+  qrCode?: string;
+  providerPaymentId?: string;
+  testMode?: boolean;
+}
+
+/**
+ * Create a payment record and call the provider's createPayment API.
+ * Returns everything the client needs to proceed (redirect URL or QR payload).
+ *
+ * Throws on unrecoverable errors (DB failure, provider 5xx after retries).
+ * Caller is responsible for translating to HTTP responses.
+ */
+export async function createCoursePayment(opts: CreatePaymentOptions): Promise<CreatedPayment> {
+  const { userId, courseId, method } = opts;
+  const providerName = opts.provider ?? pickProviderForMethod(method);
+  const provider = getProvider(providerName);
+
+  // 1. Load course
+  const course = await db.course.findUnique({ where: { id: courseId } });
+  if (!course || !course.isPublished) {
+    throw new ServiceError("COURSE_NOT_FOUND", "Курс не найден");
+  }
+  if (course.visibility === "private") {
+    throw new ServiceError("PRIVATE_COURSE", "Запись на этот курс доступна только по приглашению");
+  }
+  if (course.price === 0) {
+    throw new ServiceError("FREE_COURSE", "Этот курс бесплатный — оплата не требуется");
+  }
+
+  // 2. Promo code
+  let finalAmount = course.price;
+  let discountAmount = 0;
+  let promoCodeId: string | null = null;
+  if (opts.promoCode) {
+    const promo = await validatePromoCode(opts.promoCode, course.price, userId, courseId);
+    if (!promo.valid) {
+      throw new ServiceError("PROMO_INVALID", promo.error ?? "Промокод недействителен");
+    }
+    finalAmount = promo.finalPrice ?? course.price;
+    discountAmount = promo.discountAmount ?? 0;
+    promoCodeId = promo.promoCode?.id ?? null;
+  }
+
+  // 3. Check existing pending/completed payment (race-safe via transaction below)
+  const existing = await db.payment.findFirst({
+    where: { userId, courseId, status: { in: ["pending", "completed"] } },
+  });
+  if (existing?.status === "completed") {
+    throw new ServiceError("ALREADY_PAID", "Курс уже оплачен");
+  }
+  if (existing?.status === "pending") {
+    // Return existing payment's confirmation data if we still have it.
+    return existingAsCreated(existing, providerName, method);
+  }
+
+  // 4. Generate idempotency key + payment id up-front
+  const idempotenceKey = crypto.randomUUID();
+  const paymentId = crypto.randomUUID();
+
+  // 5. Create DB record inside transaction (race condition protection).
+  //    Provider call happens AFTER commit so we don't hold a long-running
+  //    transaction across an HTTP request.
+  const created = await db.$transaction(async (tx: Prisma.TransactionClient) => {
+    const again = await tx.payment.findFirst({
+      where: { userId, courseId, status: { in: ["pending", "completed"] } },
+    });
+    if (again?.status === "completed") throw new ServiceError("ALREADY_PAID", "Курс уже оплачен");
+    if (again?.status === "pending") return { existing: again, created: null as null | { id: string } };
+
+    const payment = await tx.payment.create({
+      data: {
+        id: paymentId,
+        userId,
+        courseId,
+        amount: finalAmount,
+        currency: course.currency || "RUB",
+        status: "pending",
+        paymentMethod: method.toLowerCase(), // store as lowercase string for backward compat
+        paymentProvider: providerName,
+        transactionId: `pending_${idempotenceKey}`, // placeholder until provider responds
+        promoCodeId,
+        discountAmount,
+      },
+    });
+    return { existing: null as null | typeof payment, created: payment };
+  });
+
+  if (created.existing) {
+    return existingAsCreated(created.existing, providerName, method);
+  }
+
+  // 6. Provider not configured? — return test mode so client can simulate.
+  if (!provider.isConfigured()) {
+    log.warn("Provider not configured, returning testMode", { provider: providerName });
+    return {
+      id: paymentId,
+      amount: finalAmount,
+      currency: course.currency || "RUB",
+      status: "pending",
+      paymentMethod: method,
+      provider: providerName,
+      testMode: true,
+    };
+  }
+
+  // 7. Build receipt (54-ФЗ) — only for providers that support it.
+  const user = await db.user.findUnique({
+    where: { id: userId },
+    select: { email: true, name: true, phone: true },
+  });
+  const receipt = (providerName === "YOOKASSA" || providerName === "TINKOFF" || providerName === "CLOUDPAYMENTS")
+    ? buildCourseReceipt({
+        courseTitle: course.title,
+        amount: finalAmount,
+        discountAmount,
+        customer: {
+          email: user?.email,
+          fullName: user?.name ?? undefined,
+          phone: user?.phone ?? undefined,
+        },
+        vatCode: 4, // УСН — adjust if you're on ОСН (1 = НДС 20%)
+      })
+    : undefined;
+
+  // 8. Call provider
+  const input: CreatePaymentInput = {
+    paymentId,
+    idempotenceKey,
+    amount: finalAmount,
+    currency: "RUB",
+    description: `Оплата курса «${course.title}» — ${env.siteUrl}`,
+    returnUrl: `${env.siteUrl}/payment/${paymentId}`,
+    method,
+    receipt,
+    customer: {
+      email: user?.email,
+      fullName: user?.name ?? undefined,
+      phone: user?.phone ?? undefined,
+    },
+    metadata: {
+      paymentId,
+      userId,
+      courseId,
+    },
+  };
+
+  let result: PaymentResult;
+  try {
+    result = await provider.createPayment(input);
+  } catch (err) {
+    // Mark payment failed so the user can retry.
+    await db.payment.updateMany({
+      where: { id: paymentId, status: "pending" },
+      data: { status: "failed" },
+    });
+    log.error("Provider createPayment failed", {
+      paymentId, provider: providerName, error: err instanceof Error ? err.message : String(err),
+    });
+    throw new ServiceError(
+      "PROVIDER_ERROR",
+      `Ошибка платёжного провайдера: ${err instanceof Error ? err.message : "unknown"}`,
+    );
+  }
+
+  // 9. Store provider payment id + confirmation URL
+  await db.payment.update({
+    where: { id: paymentId },
+    data: {
+      transactionId: result.providerPaymentId,
+      paymentData: JSON.stringify({
+        idempotenceKey,
+        providerPaymentId: result.providerPaymentId,
+        confirmationUrl: result.confirmationUrl ?? null,
+        qrCode: result.qrCode ?? null,
+        provider: providerName,
+        method,
+        receiptGenerated: !!receipt,
+      }),
+    },
+  });
+
+  // 10. Promo code redemption (only after provider accepted the payment)
+  if (promoCodeId) {
+    await redeemPromoCode(promoCodeId, userId).catch((err: unknown) => {
+      log.error("Promo code redemption failed", { paymentId, promoCodeId, error: String(err) });
+    });
+  }
+
+  return {
+    id: paymentId,
+    amount: finalAmount,
+    currency: course.currency || "RUB",
+    status: "pending",
+    paymentMethod: method,
+    provider: providerName,
+    confirmationUrl: result.confirmationUrl,
+    qrCode: result.qrCode,
+    providerPaymentId: result.providerPaymentId,
+  };
+}
+
+function existingAsCreated(
+  existing: { id: string; amount: number; currency: string; paymentMethod: string; paymentData: string | null },
+  providerName: ProviderName,
+  method: PaymentMethod,
+): CreatedPayment {
+  let confirmationUrl: string | undefined;
+  let qrCode: string | undefined;
+  if (existing.paymentData) {
+    try {
+      const data = JSON.parse(existing.paymentData);
+      confirmationUrl = data.confirmationUrl ?? undefined;
+      qrCode = data.qrCode ?? undefined;
+    } catch {
+      // ignore
+    }
+  }
+  return {
+    id: existing.id,
+    amount: existing.amount,
+    currency: existing.currency,
+    status: "pending",
+    paymentMethod: method,
+    provider: providerName,
+    confirmationUrl,
+    qrCode,
+  };
+}
+
+/**
+ * Idempotently mark a payment as completed — used by webhook handler.
+ * Atomically: updates status, creates enrollment, increments student count,
+ * schedules email + notification. Returns whether this call actually did
+ * the work (false = already completed by an earlier call).
+ */
+export async function completePayment(internalPaymentId: string, transactionId: string): Promise<{
+  alreadyCompleted: boolean;
+  payment?: { id: string; userId: string; courseId: string };
+}> {
+  const result = await db.$transaction(async (tx: Prisma.TransactionClient) => {
+    const payment = await tx.payment.findUnique({
+      where: { id: internalPaymentId },
+      include: { course: true, user: true },
+    });
+    if (!payment) throw new ServiceError("PAYMENT_NOT_FOUND", "Платёж не найден");
+    if (payment.status === "completed") return { alreadyCompleted: true, payment };
+
+    // Race-safe updateMany — only the first concurrent call succeeds.
+    const updateResult = await tx.payment.updateMany({
+      where: { id: internalPaymentId, status: "pending" },
+      data: { status: "completed", transactionId, updatedAt: new Date() },
+    });
+    if (updateResult.count === 0) return { alreadyCompleted: true, payment };
+
+    await tx.course.updateMany({
+      where: { id: payment.courseId },
+      data: { studentCount: { increment: 1 } },
+    });
+
+    await tx.enrollment.upsert({
+      where: { userId_courseId: { userId: payment.userId, courseId: payment.courseId } },
+      create: { userId: payment.userId, courseId: payment.courseId, status: "active", progress: 0 },
+      update: { status: "active" },
+    });
+
+    return { alreadyCompleted: false, payment };
+  });
+
+  return {
+    alreadyCompleted: result.alreadyCompleted,
+    payment: result.payment ? { id: result.payment.id, userId: result.payment.userId, courseId: result.payment.courseId } : undefined,
+  };
+}
+
+/**
+ * Idempotently mark a payment as refunded — cancels the enrollment.
+ */
+export async function markPaymentRefunded(internalPaymentId: string, refundData: {
+  providerRefundId?: string;
+  refundAmount?: number;
+}): Promise<{ alreadyProcessed: boolean }> {
+  const result = await db.$transaction(async (tx: Prisma.TransactionClient) => {
+    const payment = await tx.payment.findUnique({ where: { id: internalPaymentId } });
+    if (!payment) throw new ServiceError("PAYMENT_NOT_FOUND", "Платёж не найден");
+    if (payment.status === "refunded") return { alreadyProcessed: true };
+
+    const updateResult = await tx.payment.updateMany({
+      where: { id: internalPaymentId, status: "completed" },
+      data: {
+        status: "refunded",
+        paymentData: JSON.stringify({
+          refundedAt: new Date().toISOString(),
+          refundAmount: refundData.refundAmount ?? payment.amount,
+          providerRefundId: refundData.providerRefundId ?? null,
+          source: "webhook",
+        }),
+      },
+    });
+    if (updateResult.count === 0) return { alreadyProcessed: true };
+
+    await tx.enrollment.updateMany({
+      where: { userId: payment.userId, courseId: payment.courseId, status: "active" },
+      data: { status: "cancelled" },
+    });
+    await tx.course.updateMany({
+      where: { id: payment.courseId },
+      data: { studentCount: { decrement: 1 } },
+    });
+    return { alreadyProcessed: false };
+  });
+  return result;
+}
+
+/**
+ * Find a payment by the provider's payment id (stored in transactionId after
+ * createPayment succeeds). Used by the webhook when provider doesn't return
+ * our internal id in metadata.
+ */
+export async function findPaymentByProviderId(providerPaymentId: string) {
+  return db.payment.findFirst({
+    where: {
+      OR: [
+        { transactionId: providerPaymentId },
+        // Also check paymentData JSON for providerPaymentId field (less efficient)
+      ],
+    },
+  });
+}
+
+/** Custom error class with a code so route handlers can map to HTTP status. */
+export class ServiceError extends Error {
+  constructor(public readonly code: string, message: string) {
+    super(message);
+    this.name = "ServiceError";
+  }
+}
+
+/** Map ServiceError.code → HTTP status for route handlers. */
+export function serviceErrorStatus(code: string): number {
+  switch (code) {
+    case "COURSE_NOT_FOUND":
+    case "PAYMENT_NOT_FOUND":
+      return 404;
+    case "ALREADY_PAID":
+    case "FREE_COURSE":
+    case "PRIVATE_COURSE":
+    case "PROMO_INVALID":
+      return 400;
+    case "PROVIDER_ERROR":
+      return 502;
+    default:
+      return 500;
+  }
+}
