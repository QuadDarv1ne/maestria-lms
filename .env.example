# ═══════════════════════════════════════════════════
# Maestria LMS — Environment Configuration
# Auto-generated by setup.js
# ═══════════════════════════════════════════════════

# ─── Database ───
# Supported and runnable: sqlite, postgresql
# Recognised but NOT runnable in this build:
#   mysql   — needs "@prisma/adapter-mariadb" + a mysql branch in src/lib/db.ts
#   mongodb — Prisma ORM 7 has no MongoDB support (would need a new data layer)
#
# DATABASE_URL always wins over DATABASE_PROVIDER (see src/lib/db-provider.ts).
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./prisma/data.db

# Saved profiles for `npm run db:use:local` / `npm run db:use:remote`.
# Switching regenerates the Prisma Client, which is engine-specific.
# DATABASE_URL_LOCAL=file:./prisma/data.db
# DATABASE_URL_REMOTE=postgresql://user:password@host:5432/db?sslmode=verify-full
#
# TLS: put sslmode in the URL (verify-full for a valid certificate, no-verify for
# self-signed). DATABASE_SSL=true only applies when the URL has no sslmode, since
# URL parameters take precedence over it.

# ─── NextAuth ───
NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# ─── CDN & Assets ───
NEXT_PUBLIC_CDN_URL=https://ui3adtb308.a.trbcdn.net
NEXT_PUBLIC_SITE_URL=https://maestria.edu

# ─── S3 Storage (optional) ───
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://s3c3.001.gpucloud.ru
S3_BUCKET_NAME=maestria-lms
S3_REGION=auto

# ─── Development ───
ALLOW_SEED_DATA=true

# ─── Seeded demo accounts ───
# Passwords for the accounts created by the seed. When a variable is empty a
# strong password is generated and printed once by the seed run.
# Weak values are rejected: minimum 16 characters, at least one uppercase, one
# lowercase, one digit, and not a known-bad password ("demo123" etc.).
# Demo teacher created by prisma/seed.mjs:
# SEED_DEMO_PASSWORD=
# Admin + teachers created by POST /api/seed:
# SEED_ADMIN_PASSWORD=
# SEED_TEACHER_PASSWORD=

# ═══════════════════════════════════════════════════
# Payment providers
# ═══════════════════════════════════════════════════
# Webhook secret — used to verify webhook signatures for providers that
# don't sign their bodies themselves (legacy fallback path).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=

# ─── YooKassa ─────────────────────────────────────
# Get test keys immediately: https://yookassa.ru/ — register, then
# "Личный кабинет → Настройки → API ключи".
# Sandbox shopId starts with 7####### (test) — production starts with 5####### or 6#######.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Optional — override API URL (e.g. for self-hosted proxy):
# YOOKASSA_API_URL=https://api.yookassa.ru/v3

# ─── T-Bank (Tinkoff Kassa) ───────────────────────
# Apply: https://www.tbank.ru/business/internet-acquiring/
# Issued in cabinet: "Настройки → Термины" — TerminalKey + Password.
# Test terminal keys: ask your T-Bank manager.
TINKOFF_TERMINAL_KEY=
TINKOFF_PASSWORD=

# ─── CloudPayments ────────────────────────────────
# Apply: https://cloudpayments.ru/
# Cabinet: "Сайт → Настройки → API" — PublicID + API Secret.
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=

# ─── Sberbank Acquiring ───────────────────────────
# Apply: https://www.sberbank.ru/ru/s_m_business/pro/businessconnect/acquiring
# Issued after signing the contract. Username + Password for the REST API.
SBER_USERNAME=
SBER_PASSWORD=

# ─── Ozon Seller (Ozon Pay) ───────────────────────
# You must have an active Ozon Seller account: https://seller.ozon.ru/
# Cabinet: "Настройки → API ключи" — Client-Id + Api-Key.
OZON_CLIENT_ID=
OZON_API_KEY=
# Optional — sandbox URL (default: production):
# OZON_API_URL=https://api-seller.ozon.ru
# Optional — webhook signature secret (set in cabinet to verify X-Ozon-Signature):
OZON_WEBHOOK_SECRET=

# ─── VTB Acquiring ────────────────────────────────
# Apply: https://www.vtb.ru/malyy-biznes/priem-platezhey/ekvayring/
VTB_MERCHANT_ID=
VTB_SECRET_KEY=

# ─── MKB (Moscow Credit Bank) Acquiring ───────────
# Apply: https://mkb.ru/business/electronic-acquiring
MKB_MERCHANT_ID=
MKB_SECRET_KEY=

# ═══════════════════════════════════════════════════
# Notes
# ═══════════════════════════════════════════════════
# - You don't need to configure ALL providers. Set up the ones you've
#   signed contracts with. The UI will only show methods for configured
#   providers (a single test-mode option is shown when none is configured).
# - For local development: only YooKassa + T-Bank are tested end-to-end.
#   Sber/VTB/MKB are stubs — they compile, but reject webhooks and throw
#   "not implemented" on payment creation until you fill in the real API
#   calls in src/lib/payments/providers/*.
# - Webhook URL to register in each provider's cabinet:
#     https://your-domain.com/api/payments/webhook
#   All providers post to the same endpoint — the provider is detected from
#   the x-payment-provider header, the ?provider= query param, or the
#   payload shape (see detectProviderFromWebhook in src/lib/payments/registry.ts).

